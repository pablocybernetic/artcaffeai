# ============================================================
# ArtCaffe Brand Pipeline — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Storage bucket name (must match what you created in Supabase)
BRAND_BUCKET=brand-guidelines

# Claude model to use for brand context extraction and ideation
BRAND_MODEL=claude-sonnet-4-20250514

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# CORS — comma-separated list of allowed origins
# Use * for development, restrict for production. The public Locations
# API needs the Shopify storefronts listed explicitly (wildcard + credentials
# is invalid per the CORS spec, and the browser will reject it):
#   CORS_ORIGINS=https://artcaffe.co.ke,https://www.artcaffe.co.ke,https://artcaffemarket.co.ke,https://www.artcaffemarket.co.ke,https://marketing.artcaffe.co.ke
CORS_ORIGINS=*

# Locations module — encrypted settings + internal cron trigger
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Google Places/Maps API keys are NOT set here — they're entered via
# Settings → Integrations → Locations & Google Integration and stored
# encrypted under this key.
MARKETINGAI_SETTINGS_ENCRYPTION_KEY=
# Bearer token for POST /api/internal/jobs/google-location-sync
CRON_SECRET=
